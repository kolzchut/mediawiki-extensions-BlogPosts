{
	"name": "Blog Posts",
	"version": "0.0.1",
	"author": [
		"Tal Koren (Interjet, Kol Zchut)"
	],
	"descriptionmsg": "An extension that fetches and displays posts from a remote WordPress API",
	"url": "https://github.com/kolzchut/mediawiki-extensions-BlogPosts",
	"license-name": "MIT",
	"type": "other",
	"requires": {
		"MediaWiki": ">= 1.39.0",
		"platform": {
			"php": ">= 8.1"
		}
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\BlogPosts\\": "includes/"
	},
	"APIModules": {
		"get-posts": {
			"class": "MediaWiki\\Extension\\BlogPosts\\GetPostsAPI",
			"services": [
				"MainConfig",
				"HttpRequestFactory"
			]
		}
	},
	"HookHandlers": {
		"main": {
			"class": "MediaWiki\\Extension\\BlogPosts\\Hooks",
			"services": [
				"MainConfig",
				"HttpRequestFactory"
			]
		}
	},
	"Hooks": {
		"ResourceLoaderGetConfigVars": "main",
		"ParserFirstCallInit": "main"
	},
	"ResourceFileModulePaths": {
		"localBasePath": "",
		"remoteExtPath": "WikiRights/BlogPosts"
	},
	"ResourceModules": {
		"ext.BlogPosts.styles": {
			"styles": "resources/blog-posts.style.less"
		}
	},
	"MessagesDirs": {
		"BlogPosts": [
			"i18n"
		]
	},
	"config": {
		"BlogPostsConfig": {
			"value": {
				"blogURL": null,
				"morePostsUrl": null,
				"postsPerPage": 4,
				"initialPage": 1
			}
		}
	},
	"manifest_version": 2
}
